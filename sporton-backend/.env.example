# Nusxa: cp .env.example .env  va qiymatlarni to‘ldiring.
# Maxfiy kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=replace-me-run-python-get-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=sporton
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# MySQL Workbench: avval bo‘sh schema yarating, masalan:
# CREATE DATABASE sporton CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Keyin: python manage.py migrate

# Eski SQLite dan ko‘chirish (bir marta):
# python manage.py dumpdata --natural-foreign --natural-primary --exclude contenttypes --exclude auth.Permission > backup.json
# MySQL da migrate qilgach: python manage.py loaddata backup.json
